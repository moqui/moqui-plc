<entity-facade-xml type="seed">

    <!-- Standard recipe export: a DrtConfigWrite to a file or SFTP endpoint, run by moqui-device-gateway.
         moqui.device.DeviceConfigServices.export#DeviceConfig renders the DeviceRuleSet in query as
         name:=value files; running the request alone exports that rule set too. The name follows the
         {deviceId}_ExportProcess convention of the device screens. -->

    <moqui.device.DeviceRequest
            requestName="${DEVICE_ID}_ExportProcess"
            deviceId="${DEVICE_ID}"
            requestTypeEnumId="DrtConfigWrite"
            purposeEnumId="DrpCommissioning"
            routerEnumId="DrrDirect"
            runServiceName="moqui.device.gateway.FileServices.run#DeviceRequest"
            brokerUri="${RECIPE_EXPORT_URI}"
            query="${RECIPE_RULE_SET_ID}"
            timeout="${TIMEOUT}"
            onlyChangedParameters="N"/>

</entity-facade-xml>
