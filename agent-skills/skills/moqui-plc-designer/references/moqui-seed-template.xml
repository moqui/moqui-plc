<entity-facade-xml type="seed">

    <!-- Parameter purposes and naming should remain aligned with moqui-math and moqui-device -->

    <!-- ParameterDef -->
    <moqui.math.ParameterDef parameterDefId="${PARAMETER_DEF_ID}"
            parameterName="${PARAMETER_NAME}"
            description="${PARAMETER_DESCRIPTION}"
            parameterTypeEnumId="${PARAMETER_TYPE_ENUM_ID}"
            purposeEnumId="${PURPOSE_ENUM_ID}"/>

    <!-- Parameter with numeric value -->
    <moqui.math.Parameter parameterId="${PARAMETER_ID}"
            parameterDefId="${PARAMETER_DEF_ID}"
            deviceId="${DEVICE_ID}"
            fromDate="${FROM_DATE}"
            numericValue="${NUMERIC_VALUE}"/>

    <!-- Parameter with symbolic value -->
    <moqui.math.Parameter parameterId="${PARAMETER_ID}"
            parameterDefId="${PARAMETER_DEF_ID}"
            deviceId="${DEVICE_ID}"
            fromDate="${FROM_DATE}"
            symbolicValue="${SYMBOLIC_VALUE}"/>

    <!-- Parameter with free enumerative value (no FK to Moqui Enumeration required) -->
    <moqui.math.Parameter parameterId="${PARAMETER_ID}"
            parameterDefId="${PARAMETER_DEF_ID}"
            deviceId="${DEVICE_ID}"
            fromDate="${FROM_DATE}"
            parameterEnumId="${PARAMETER_ENUM_ID}"/>

    <!-- DeviceRequest -->
    <moqui.device.DeviceRequest requestName="${REQUEST_NAME}"
            deviceId="${DEVICE_ID}"
            requestTypeEnumId="${REQUEST_TYPE_ENUM_ID}"
            purposeEnumId="${REQUEST_PURPOSE_ENUM_ID}"
            pollingInterval="${POLLING_INTERVAL}"
            timeout="${TIMEOUT}"
            runServiceName="${RUN_SERVICE_NAME}"/>

    <!-- DeviceRequestItem -->
    <moqui.device.DeviceRequestItem requestName="${REQUEST_NAME}"
            requestItemName="${REQUEST_ITEM_NAME}"
            parameterId="${PARAMETER_ID}"
            sequenceNum="${REQUEST_ITEM_SEQUENCE_NUM}"
            query="${QUERY}"
            itemTypeEnumId="${ITEM_TYPE_ENUM_ID}"/>

    <!-- StatusType -->
    <moqui.basic.StatusType statusTypeId="${STATUS_TYPE_ID}"
            description="${STATUS_TYPE_DESCRIPTION}"/>

    <!-- StatusItem -->
    <moqui.basic.StatusItem statusId="${STATUS_ID}"
            statusTypeId="${STATUS_TYPE_ID}"
            description="${STATUS_DESCRIPTION}"
            sequenceNum="${STATUS_SEQUENCE_NUM}"/>

    <!-- StatusFlow -->
    <moqui.basic.StatusFlow statusFlowId="${STATUS_FLOW_ID}"
            statusTypeId="${STATUS_TYPE_ID}"
            description="${STATUS_FLOW_DESCRIPTION}"/>

    <!-- StatusFlowItem -->
    <moqui.basic.StatusFlowItem statusFlowId="${STATUS_FLOW_ID}"
            statusId="${STATUS_ID}"
            isInitial="${IS_INITIAL}"/>

    <!-- StatusFlowTransition -->
    <moqui.basic.StatusFlowTransition statusFlowId="${STATUS_FLOW_ID}"
            statusId="${FROM_STATUS_ID}"
            toStatusId="${TO_STATUS_ID}"
            transitionName="${TRANSITION_NAME}"
            transitionSequence="${TRANSITION_SEQUENCE}"/>

</entity-facade-xml>
