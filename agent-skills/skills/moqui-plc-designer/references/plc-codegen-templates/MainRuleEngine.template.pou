{attribute 'no_assign'}
(* 
 * MainRuleEngine - transition-condition logic for the supervisor FSM.
 *
 * Responsibilities:
 *   1. Reset transition requests to safe defaults.
 *   2. Run the signal management engine (fault / alarm / warning detection).
 *   3. Compute boolean predicates from sensor feedback and recipe setpoints.
 *   4. Implement the per-state transition-condition rules.
 *
 * Requests are reset every scan. A state persists until a reviewed transition
 * condition asserts the corresponding request consumed by Main.
 *)
FUNCTION_BLOCK MainRuleEngine
VAR_EXTERNAL
    clks : Clocks;
    dev : DeviceFacade;
    workEffort : WorkEffort;
END_VAR
VAR_INPUT
    operationType : OperatingMode := OperatingMode.Run;
END_VAR
VAR_OUTPUT
    error : BOOL;
END_VAR
VAR
    (* Device diagnostics *)
    deviceDiags : DeviceDiagnostics;
END_VAR

(* Reset transition requests to FALSE before evaluating transition policy. *)
${REQUEST_RESET_BLOCK}

deviceDiags(operationType := operationType, error => error);

(* Compute sensor predicates *)
${SENSOR_PREDICATES}

(* Fault gate *)
IF ${FAULT_CONDITION} THEN
    dev.faultRequest := TRUE;
    RETURN;
END_IF;

(* Transition-condition rule engine. Conditions are evaluated by precedence. *)
CASE dev.status OF
${STATE_TRANSITION_CASES}
END_CASE;
