<entity-facade-xml type="seed">

    <!--
    Standard live-parameter request for values acquired in
    moqui/moqui-plc through MqttParameterSub.

    The request family is fixed.
    The real variability is in the repeated DeviceRequestItem rows.
    -->

    <moqui.device.DeviceRequest
            requestName="${DEVICE_ID}_LiveParametersMqttSub"
            deviceId="${DEVICE_ID}"
            requestTypeEnumId="DrtCyclic"
            purposeEnumId="DrpMonitoring"
            routerEnumId="DrrBroker"
            brokerUri="${LIVE_PARAMETERS_BROKER_URI}"
            pollingInterval="${POLLING_INTERVAL}"/>

    <!-- Repeat one row like this for each live parameter published by MqttParameterSub in moqui/moqui-plc -->
    <moqui.device.DeviceRequestItem
            requestName="${DEVICE_ID}_LiveParametersMqttSub"
            parameterId="${LIVE_PARAMETER_ID_1}"
            sequenceNum="1"
            requestItemName="${LIVE_REQUEST_ITEM_NAME_1}"
            query="${LIVE_QUERY_1}"
            itemTypeEnumId="${LIVE_ITEM_TYPE_ENUM_ID_1}"/>

</entity-facade-xml>
