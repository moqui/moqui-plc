<entity-facade-xml type="seed">

    <moqui.device.Device
            deviceId="${DIGITAL_SENSOR_DEVICE_ID}"
            parentDeviceId="${PARENT_DEVICE_ID}"
            deviceTypeEnumId="${DIGITAL_SENSOR_DEVICE_TYPE_ENUM_ID}"
            purposeEnumId="${DIGITAL_SENSOR_PURPOSE_ENUM_ID}"
            description="${DIGITAL_SENSOR_DESCRIPTION}"/>

    <moqui.device.PhysicalDevice
            deviceId="${DIGITAL_SENSOR_DEVICE_ID}"
            deviceName="${DIGITAL_SENSOR_NAME}"/>

    <moqui.math.ParameterDef
            parameterDefId="${PD_SENSOR_VALUE}"
            parameterTypeEnumId="PtTextIndicator"
            purposeEnumId="PpFeedback"
            parameterCode="${DIGITAL_SENSOR_PARAMETER_CODE_PREFIX}.01"
            parameterName="Sensor Value"
            description="Current measured boolean value of the digital sensor."
            />

    <moqui.math.Parameter
            parameterId="${P_SENSOR_VALUE}"
            parameterDefId="${PD_SENSOR_VALUE}"
            deviceId="${DIGITAL_SENSOR_DEVICE_ID}"
            symbolicValue="N"/>

</entity-facade-xml>
