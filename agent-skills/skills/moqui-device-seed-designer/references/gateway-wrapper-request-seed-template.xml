<entity-facade-xml type="seed">

    <!-- Standard recipe export wrapper for moqui-device-gateway. -->

    <moqui.device.Device
            deviceId="${GATEWAY_DEVICE_ID}"
            deviceTypeEnumId="DtIoTGateway"/>

    <moqui.device.PhysicalDevice
            deviceId="${GATEWAY_DEVICE_ID}"
            deviceName="${GATEWAY_DEVICE_NAME}"/>

    <moqui.device.DeviceRequest
            requestName="${GATEWAY_DEVICE_ID}_ExportRecipe"
            deviceId="${GATEWAY_DEVICE_ID}"
            requestTypeEnumId="DrtConfigWrite"
            purposeEnumId="DrpCommissioning"
            routerEnumId="DrrMoquiDeviceGateway"
            runServiceName="moqui.device.DeviceGatewayServices.export#DeviceConfig"
            brokerUri="${GATEWAY_BASE_URL}"
            timeout="${TIMEOUT}"
            onlyChangedParameters="N"/>

</entity-facade-xml>
