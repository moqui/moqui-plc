    <!--
    Optional direct OPC UA request template derived from moqui-device-gateway
    test fixtures.

    This fragment is useful as an internal reference or for installations that
    still want direct transport-oriented requests. It is not part of the
    standard minimal request set normally used for moqui-plc systems.
    -->

    <moqui.device.DeviceConnection
            connectionName="VPL_OPCUA_CONN_S001"
            deviceId="VIRTUAL_PLC_OPCUA_S001"
            connectionTypeEnumId="DctDirectConnection"
            purposeEnumId="DcpOperations"
            driverEnumId="DcdOpcUa"
            transportEnumId="DctrTcp"
            transportConfig="opc.tcp://127.0.0.1:12686/milo"
            options=""/>

    <moqui.device.DeviceRequest
            requestName="VPL_OPCUA_READ_REQ_S001"
            deviceId="VIRTUAL_PLC_OPCUA_S001"
            requestTypeEnumId="DrtCyclic"
            purposeEnumId="DrpControl"
            routerEnumId="DrrDirect"
            connectionName="VPL_OPCUA_CONN_S001"
            pollingInterval="100"/>

    <moqui.device.DeviceRequestItem
            requestName="VPL_OPCUA_READ_REQ_S001"
            parameterId="VPL_PARAM_REFERENCE_OPCUA_S001"
            sequenceNum="1"
            requestItemName="virtualPlcFeedback"
            query="ns=2;s=Demo.Dynamic.Scalar.Double"
            itemTypeEnumId="DritReal"/>

    <moqui.device.DeviceRequestItem
            requestName="VPL_OPCUA_READ_REQ_S001"
            parameterId="VPL_PARAM_FEEDBACK_OPCUA_S001"
            sequenceNum="2"
            requestItemName="virtualPlcFault"
            query="ns=2;s=Demo.Dynamic.Scalar.Boolean"
            itemTypeEnumId="DritBool"/>

    <moqui.device.DeviceRequest
            requestName="VPL_OPCUA_UNSUB_REQ_S001"
            parentRequestName="VPL_OPCUA_READ_REQ_S001"
            deviceId="VIRTUAL_PLC_OPCUA_S001"
            requestTypeEnumId="DrtUnsubscribe"
            purposeEnumId="DrpControl"
            routerEnumId="DrrDirect"
            connectionName="VPL_OPCUA_CONN_S001"/>

    <moqui.device.DeviceRequest
            requestName="VPL_OPCUA_WRITE_REQ_S001"
            deviceId="VIRTUAL_PLC_OPCUA_S001"
            requestTypeEnumId="DrtWrite"
            purposeEnumId="DrpControl"
            routerEnumId="DrrDirect"
            connectionName="VPL_OPCUA_CONN_S001"
            onlyChangedParameters="N"/>

    <moqui.device.DeviceRequestItem
            requestName="VPL_OPCUA_WRITE_REQ_S001"
            parameterId="VPL_PARAM_FAULT_OPCUA_S001"
            sequenceNum="1"
            requestItemName="virtualPlcReference"
            query="ns=2;s=Demo.Dynamic.Scalar.Double"
            itemTypeEnumId="DritReal"/>

