    <!--
    Standard live-parameter request for values acquired in moqui-plc through
    MqttParameterSub.

    The request family is fixed.
    The real variability is in the repeated DeviceRequestItem rows.
    -->

    <moqui.device.DeviceRequest
            requestName="VIRTUAL_PLC_S001_LiveParametersMqttSub"
            deviceId="VIRTUAL_PLC_S001"
            requestTypeEnumId="DrtCyclic"
            purposeEnumId="DrpMonitoring"
            routerEnumId="DrrBroker"
            brokerUri="paho-mqtt5:virtual_plc_live?brokerUrl=tcp://localhost:1883"
            pollingInterval="100"/>

    <!-- Repeat one row like this for each live parameter published by MqttParameterSub -->
    <moqui.device.DeviceRequestItem
            requestName="VIRTUAL_PLC_S001_LiveParametersMqttSub"
            parameterId="VPL_PARAM_FAULT_S001"
            sequenceNum="1"
            requestItemName="virtualPlcFault"
            query="virtual_plc_fault"
            itemTypeEnumId="DritBool"/>

