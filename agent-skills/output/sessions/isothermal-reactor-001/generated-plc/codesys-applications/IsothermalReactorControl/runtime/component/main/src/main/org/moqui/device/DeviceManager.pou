{attribute 'no_assign'}
(* Hardware Abstraction Layer (HAL) orchestrator.
 *
 * Drives all physical device FBs once per scan.
 * Main component sets the enable/disable request flags; DeviceManager wires them
 * to the individual Actuator / ProcessPid FBs.
 *
 * Call order within the PLC task:
 *   InputSignalUpdate (updates feedback signals from field)
 *   Main (FSM + DeviceRuleEngine -> sets request flags)
 *   DeviceManager (this block - drives device FBs)
 *   OutputSignalUpdate (maps device outputs to physical terminals)
 *
 * Handshake note (Actuator FBs):
 *   enableRequest / disableRequest are VAR_IN_OUT.  The Actuator FB clears
 *   the flag as its acknowledgment.  Main.pou re-asserts the flag each scan
 *   from dev.xxxEnableRequest, so the handshake is level-triggered.
 *
 * ProcessPid note (ahuFan):
 *   ProcessPid uses a plain BOOL 'enable' input - no VAR_IN_OUT handshake.
 *   Setting enable := FALSE ramps the output to 0 and disables the controller.
 *)
FUNCTION_BLOCK DeviceManager
VAR_EXTERNAL
    clks : Clocks;
    dev : DeviceFacade;
END_VAR
VAR_INPUT
    operationType : OperatingMode := OperatingMode.Run;
END_VAR

(* Atomic device orchestration *)
(* ConcentrationController *)
dev.concentrationController(
    enable := dev.concentrationControllerEnable,
    reset := dev.concentrationControllerReset,
    controlSystemId := dev.concentrationControllerControlSystemId,
    controlSystemName := dev.concentrationControllerControlSystemName,
    feedback := dev.concentrationControllerFeedback,
    feedbackMultiplier := dev.concentrationControllerFeedbackMultiplier,
    setpoint := dev.concentrationControllerSetpoint,
    atSetpointHysteresis := dev.concentrationControllerAtSetpointHysteresis,
    setpointMultiplier := dev.concentrationControllerSetpointMultiplier,
    setpointMin := dev.concentrationControllerSetpointMin,
    setpointMax := dev.concentrationControllerSetpointMax,
    setpointRampType := dev.concentrationControllerSetpointRampType,
    setpointIncreaseTime := dev.concentrationControllerSetpointIncreaseTime,
    setpointDecreaseTime := dev.concentrationControllerSetpointDecreaseTime,
    setpointFreezeEnable := dev.concentrationControllerSetpointFreezeEnable,
    deviationInversion := dev.concentrationControllerDeviationInversion,
    outputMin := dev.concentrationControllerOutputMin,
    outputMax := dev.concentrationControllerOutputMax,
    outputFreezeEnable := dev.concentrationControllerOutputFreezeEnable,
    gain := dev.concentrationControllerGain,
    integrationTime := dev.concentrationControllerIntegrationTime,
    derivationTime := dev.concentrationControllerDerivationTime,
    offset := dev.concentrationControllerOffset,
    deadbandRange := dev.concentrationControllerDeadbandRange,
    deadbandDelay := dev.concentrationControllerDeadbandDelay,
    sleepLevel := dev.concentrationControllerSleepLevel,
    sleepDelay := dev.concentrationControllerSleepDelay,
    wakeupDeviation := dev.concentrationControllerWakeupDeviation,
    wakeupDelay := dev.concentrationControllerWakeupDelay,
    sleepBoostLevel := dev.concentrationControllerSleepBoostLevel,
    sleepBoostTime := dev.concentrationControllerSleepBoostTime,
    trackingMode := dev.concentrationControllerTrackingMode,
    trackingRef := dev.concentrationControllerTrackingRef,
    clock := clks.clock10ms,
    tickTime := dev.concentrationControllerTickTime,
    setpointEpsilon := dev.concentrationControllerSetpointEpsilon);

(* Questions for the skill/user:
 * 1. Which atomic devices must be called every scan?
 * 2. For each Actuator, which enableRequest/disableRequest flags drive it?
 * 3. For each ProcessPid, which enable/setpoint/feedback signals drive it?
 * 4. For each Axis or AxisGroup, which command/enable structures are used?
 *)
