    <moqui.math.ParameterDef parameterDefId="PD_DILUTION_RATE_OUT" parameterTypeEnumId="PtNumberDecimal" purposeEnumId="PpControl" parameterCode="SIG.002" parameterName="DilutionRateOut" description="Physical AO representing the dilution rate command (F/V, min^-1), not a 0-100% valve signal (developer-confirmed choice, matches the source material's units and its manipulated-variable excursion constraint directly). Renders as dev.concentrationControllerDilutionRateOut. Converting this to an actual feed valve/pump command using the known constant reactor volume V is manual, in OutputSignalUpdate." />
    <moqui.math.Parameter parameterId="P_DILUTION_RATE_OUT" parameterDefId="PD_DILUTION_RATE_OUT" deviceId="REACTOR_CC" numericValue="0" />
