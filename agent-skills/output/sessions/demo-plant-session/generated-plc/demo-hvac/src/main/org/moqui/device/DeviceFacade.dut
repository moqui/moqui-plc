(* 
 * DeviceFacade implementation for managing devices and logical parameters.
 *
 * Naming rules:
 *   deviceName + parameterName or parameterName -> logical signal
 *   deviceName + parameterName or parameterName + Min/Max -> limits
 *
 * All digital signals (boolean) are active-high (positive logic).
 * All durations are expressed in seconds TUnit.
 *)
TYPE DeviceFacade : STRUCT
    (* ========== Analog process/environment parameters ========== *)
    (* TODO: declare REAL process/environment parameters *)

    (* ========== Digital process/environment parameters ========== *)
    (* TODO: declare BOOL process/environment parameters *)

    (* Boolean predicates - computed each scan by MainRuleEngine *)
    (* TODO: declare computed predicates used by MainRuleEngine *)

    (* Operating-mode flags and process timing (mapped from recipe). *)
    estimatedRuntime : TUnit;
    minRuntime : TUnit;
    estimatedBreakDuration : TUnit;
    minBreakDuration : TUnit;
    processEstimatedDuration : TUnit;
    processMinDuration : TUnit;
    processActualDuration : TUnit;
    processRemainingDuration : TUnit;
    actualRuntime : TUnit;
    actualBreakDuration : TUnit;
    timeBreakEnabled : BOOL;
    isCompleted : BOOL;

    (* Main FSM state and transition request/acknowledge commands *)
    status : MainStatus := MainStatus.Disabled;
    lastStatus : MainStatus := MainStatus.Disabled;
    disabledRequest : BOOL;
    standstillRequest : BOOL;
    homingRequest : BOOL;
    runRequest : BOOL;
    synchronizedRunRequest : BOOL;
    stoppingRequest : BOOL;
    errorStopRequest : BOOL;
    faultRequest : BOOL;
    faultAck : BOOL;

    (* ========== Atomic devices ========== *)
    (* TODO: declare Actuator/ActuatorGroup/Axis/AxisGroup/ProcessPid instances *)

    (* Signal management - centralised fault / alarm / warning engine *)
    signalMgmt : SignalMgmt;
END_STRUCT END_TYPE

